# Copy this file to .env and fill in the empty values. .env is git-ignored: never commit it.
# Docker Compose reads .env automatically. When you run a service from your IDE instead,
# set the same variables in its run configuration.

# PostgreSQL. These local defaults match the defaults in s1-write's application.yml,
# so S1 started from the IDE connects to the Compose database without extra setup.
DB_NAME=fixflow
DB_USER=fixflow
DB_PASSWORD=fixflow

# Read-only login for mcp-server. Created on the database's first start.
DB_READONLY_USER=fixflow_readonly
DB_READONLY_PASSWORD=fixflow_readonly

# Shared by S1 (signs tokens) and S2 (validates them). HS256 needs a key of at least 256 bits:
# use 32 or more characters; both services use the UTF-8 bytes of this value as the key.
# For example: openssl rand -base64 32
JWT_SECRET=

# Sent by S2 in the X-Webhook-Secret header and checked by S1. Any long random string.
WEBHOOK_SECRET=

# Google Gemini API key, only needed when S2 runs with the gemini profile (not with mock).
GEMINI_API_KEY=
